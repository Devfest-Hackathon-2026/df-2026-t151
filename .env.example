# Server-only settings. Never prefix credentials with NEXT_PUBLIC_.
# Required for Vertex AI ADC and Maps service-account mode; not a secret.
GOOGLE_CLOUD_PROJECT=
# Vertex AI location. The existing Gemini model and Maps grounding use global.
GOOGLE_CLOUD_LOCATION=global
# Maps authentication remains separately selectable for local development.
GOOGLE_MAPS_AUTH_MODE=api-key
# Used only for Maps api-key mode. Referrer restrictions do not fit server calls.
GOOGLE_MAPS_API_KEY=
# Server-only HMAC secret, 32-256 non-whitespace characters. Share across instances.
OPTION_TOKEN_SECRET=
# Vertex AI always uses ADC. GEMINI_API_KEY is no longer read.
